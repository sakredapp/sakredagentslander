{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "shared/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "https://app.sakredagents.com/login",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "https://app.sakredagents.com/login",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "https://app.sakredagents.com/login",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://app.sakredagents.com/login",
      "permanent": false
    }
  ]
}
